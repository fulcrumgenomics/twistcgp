/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test overrides: use COMMITTED annotation caches (in-repo, no external deps, CI-portable)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Layered on top of `-profile test`. Points VEP/SnpEff at small caches committed
    under assets/test-data/, so annotation runs from git alone.

    - VEP: a 4-region human subset (chr 3/7/12/17) that really annotates the
      committed cancer hotspots (BRAF/KRAS/PIK3CA/TP53) — VEP drives TMB & downstream.
    - SnpEff: a ~250-byte throwaway GRCh38.105 database. SnpEff output is NOT consumed
      downstream, so it only needs to load and run; it passes records through
      (hotspots are out of its tiny contigs). Genome registration via -configOption
      (snpEff 5.3a won't auto-register a -dataDir genome).

    Usage (CLI):
        nextflow run main.nf -profile test,docker -c conf/test_annotation.config --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    ensemblvep_cache         = "${projectDir}/assets/test-data/vep_cache"
    ensemblvep_cache_version = '114'
    snpeff_cache             = "${projectDir}/assets/test-data/snpeff_cache"
    snpeff_db                = '105'
}

process {
    // Re-enable the annotation/TMB processes that conf/test.config disables for the empty
    // smoke test; here they run against the committed hotspot fixtures. TMB_PYTMB keeps its
    // skip_tmb gate so it only runs in scenarios that ask for it.
    withName: SNPEFF_SNPEFF {
        ext.when = { true }
        ext.args = { '-canon -v -configOption GRCh38.105.genome=GRCh38.105' }
    }
    withName: TABIX_BGZIPTABIX {
        ext.when = { true }
    }
    withName: '.*:ENSEMBLVEP_VEP' {
        ext.when = { true }
    }
    withName: "GATK4_FILTERMUTECTCALLS" {
        ext.when = { true }
    }
    withName: "TMB_PYTMB" {
        ext.when = { params.skip_tmb == false }
    }
}
