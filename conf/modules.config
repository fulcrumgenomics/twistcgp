/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: ALIGNBAM {
        // Template-coordinate sorted and unindexed; an intermediate for DEDUPBAM, not a deliverable.
        publishDir = [
            enabled: false,
        ]
    }

    withName: BCFTOOLS_VIEW_PRE_CIVIC {
        ext.when = { params.skip_tmb == false }
        // NB: ext.args must include --write-index=tbi for downstream processes to run successfully
        ext.args = {
            [
                '--apply-filters PASS',
                '--types snps',
                "--include 'POPAF >= ${params.tmb_popaf_cutoff} && FORMAT/AF >= ${params.tmb_vaf_cutoff}'",
                '--output-type z',
                '--write-index=tbi',
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.pre_civic_filtered" }
        publishDir = [
            enabled: false,
        ]
    }

    withName: BCFTOOLS_VIEW_POST_CIVIC {
        ext.when = { params.skip_tmb == false && params.skip_civicpy == false }
        // NB: ext.args must include --write-index=tbi for downstream processes to run successfully
        ext.args = {
            [
                "--include 'CIVIC=\".\"'",
                '--output-type z',
                '--write-index=tbi',
            ].join(' ')
        }
        ext.prefix = { "${meta.id}.pre_tmb_filtered" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{vcf.gz,vcf.gz.tbi}",
        ]
    }

    withName: BWAMEM3_INDEX {
        ext.when = { !params.bwa }
        // The auto budget is cgroup-aware, but Singularity sets no memory cgroup, so it would
        // resolve against host RAM. Pin it to task.memory (less 2 GiB) instead.
        ext.args = { "--max-memory ${task.memory.toGiga() - 2}G" }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: CIVICPY_UPDATE_CACHE {
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }
    withName: CIVICPY_ANNOTATE {
        ext.args = '--include-status accepted'
        ext.prefix = { "${meta.id}.civic" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*vcf.gz",
        ]
    }

    withName: CNVKIT_BATCH {
        ext.when = { params.skip_cnv == false }
        // hmm-tumor performs well for relatively pure, high coverage tumor samples
        // alternative segmentation methods can be explored here:
        // https://cnvkit.readthedocs.io/en/stable/pipeline.html#segmentation-methods
        ext.args = "--segment-method hmm-tumor"
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{bed,cnn,cnr,cns,pdf,png}",
        ]
    }

    withName: ENSEMBLVEP_DOWNLOAD {
        ext.when = { !params.ensemblvep_cache }
        ext.args = { '--AUTO c --CONVERT --NO_BIOPERL --NO_HTSLIB --NO_TEST --NO_UPDATE' }
        publishDir = [
            path: { "${params.outdir}/reference/ensemblvep_cache" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: 'ENSEMBLVEP_VEP' {
        // --custom uses the staged basename so remote inputs (e.g. s3://) resolve to the local copy
        // --af_gnomade/--af_gnomadg pull gnomAD exome + genome frequencies from the VEP cache;
        // genome frequencies matter because hybrid-capture baits may target intronic/non-coding regions
        // that gnomAD exome does not cover. --custom uses the staged basename so remote inputs (e.g. s3://) resolve to the local copy.
        ext.args = { "--format vcf --vcf --af_gnomade --af_gnomadg --af_1kg" + (params.cosmic_vcf ? " --custom ${file(params.cosmic_vcf).name},COSMIC,vcf,exact,0,ID" : "") }
        ext.prefix = { "${meta.id}.vep" }
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/${meta.id}/" },
                pattern: "*{gz,gz.tbi,html}",
            ]
        ]
    }

    withName: GATK4_MUTECT2 {
        ext.args = { "--interval-padding ${params.target_padding} --f1r2-tar-gz ${meta.id}.f1r2.tar.gz" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{gz,stats,tbi}",
        ]
    }

    withName: GATK4_FILTERMUTECTCALLS {
        ext.prefix = { "${meta.id}.labeled" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{vcf.gz,vcf.gz.tbi,filteringStats.tsv}",
        ]
    }

    withName: GATK4_CALCULATECONTAMINATION {
        ext.prefix = { "${meta.id}" }
        // Always pass --tumor-segmentation so the segmentation output is always produced
        ext.args = { "--tumor-segmentation ${task.ext.prefix}.segmentation.table" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*table",
        ]
    }

    withName: GATK4_GETPILEUPSUMMARIES {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*table",
        ]
    }

    withName: GATK4_LEARNREADORIENTATIONMODEL {
        ext.prefix = { "${meta.id}.read_orientations" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.tar.gz",
        ]
    }

    withName: CHELAE_TRIM {
        // Mirror the read-level filtering fastp applied by default, so swapping the trimmer does not
        // silently change which reads are kept: -q 15 -u 40 -> --filter-low-qual 15:0.4, -n 5 -> --filter-max-ns 5,
        // -l 15 -> --filter-length 15. poly-G trim, PE-overlap adapter detection, and the 0.125 adapter
        // mismatch rate are already on/matched by chelae's defaults; sliding-window and mean-quality
        // filters stay off, matching fastp.
        ext.args = '--filter-low-qual 15:0.4 --filter-max-ns 5 --filter-length 15'
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{fastq.gz,json,tsv}",
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{html,zip}",
        ]
    }

    withName: FGUMI_EXTRACT {
        // fgumi accepts one read structure per input FASTQ.
        // Default is template-only FASTQs. Pin it explicitly
        // so enabling UMI extraction is a one-line change
        // (e.g. 8M+T).
        ext.args = { meta.single_end ? '--read-structures +T' : '--read-structures +T +T' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
        ]
    }

    withName: MSISENSORPRO_SCAN {
        ext.when = { !params.msisensor_pro_sites }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: MSISENSOR2_MSI {
        ext.when = { params.skip_msi == false }
        // NB: The module outputs the summary file as "${prefix}"
        ext.prefix = { "${meta.id}.msi" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*msi*",
        ]
    }

    withName: MSISENSORPRO_PRO {
        ext.when = { params.skip_msi == false }
        // NB: The module outputs the summary file as "${prefix}"
        ext.prefix = { "${meta.id}.msi" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*msi*",
        ]
    }

    withName: PERBASE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv.gz',
        ]
    }

    withName: 'PICARD.*' {
        ext.args = {
            "-XX:GCTimeLimit=50 -XX:GCHeapFreeLimit=10 -Dsamjdk.use_async_io_read_samtools=true " + "-Dsamjdk.use_async_io_write_samtools=true"
        }
    }

    withName: RIKER_MULTI {
        ext.args = '--tools hybcap alignment basic isize gcbias error --hybcap::near-distance 500 --hybcap::per-target-coverage --error::stratify-by bq isize gc strand pair_orientation hp_len cycle read_num read_num,cycle read_num,hp_len read_num,gc read_num,pre_dinuc mapq nm context_3bp'
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{.txt,.pdf,.gz}",
        ]
    }

    withName: PICARD_INTERVALLISTTOBED {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{.bed}",
        ]
    }

    withName: DEDUPBAM {
        ext.prefix = { "${meta.id}.mapped.dup_marked" }
        // This pipeline has no UMIs.
        // --no-umi groups by position only, giving plain coordinate-based duplicate marking.
        // fgumi dedup also filters reads; --include-unmapped and --include-non-pf-reads
        // retain the templates Picard MarkDuplicates passed through untouched.
        ext.fgumi_dedup_args = '--no-umi --include-unmapped --include-non-pf-reads'
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,bai,metrics.txt,family_size_histogram.txt}',
        ]
    }

    withName: SAMTOOLS_FAIDX {
        ext.when = { !params.fasta_fai }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SAMTOOLS_DICT {
        ext.when = { !params.dict }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SNPEFF_DOWNLOAD {
        ext.when = { !params.snpeff_cache }
        publishDir = [
            path: { "${params.outdir}/reference/snpeff_cache" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SNPEFF_SNPEFF {
        ext.args = { '-canon -v' }
        //allow canonical transcripts
        ext.prefix = { "${meta.id}.snpeff" }
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/${meta.id}/" },
                pattern: "*{csv,html,txt}",
            ]
        ]
    }

    withName: TMB {
        ext.when = { params.skip_tmb == false }
        // VAF, minDepth, and minAltDepth recommended by: https://friendsofcancerresearch.org/publication/in-silico-assessment-of-variation-in-tmb-quantification-across-diagnostic-platforms-phase-1-of-the-friends-of-cancer-research-harmonization-project/
        ext.args = "--polymDb gnomad --filterPolym --vaf ${params.tmb_vaf_cutoff} --minDepth 25 --minAltDepth 3 --filterLowQual --filterIndels --filterNonCoding --filterSyn --maf 0.01"
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*{log}',
        ]
    }

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*VCF_ANNOTATE_ENSEMBLVEP:TABIX_TABIX' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/${meta.id}/" },
            pattern: "*.tbi",
        ]
    }

    withName: '.*VCF_ANNOTATE_SNPEFF:TABIX_BGZIPTABIX' {
        ext.prefix = { "${meta.id}.snpeff" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/${meta.id}/" },
            pattern: "*{gz,gz.tbi}",
        ]
    }

    withName: TABIX_POPULATION_GERMLINE {
        ext.when = { params.population_germline_vcf && !params.population_germline_tbi }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            pattern: "*.tbi",
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: TABIX_PON {
        ext.when = { params.pon_vcf && !params.pon_tbi }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            pattern: "*.tbi",
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: TABIX_COSMIC {
        ext.when = { params.cosmic_vcf && !params.cosmic_tbi }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            pattern: "*.tbi",
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }
    withName: TABIX_GNOMAD {
        ext.when = { params.gnomad_vcf && !params.gnomad_tbi }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/reference" : params.outdir },
            mode: params.publish_dir_mode,
            pattern: "*.tbi",
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }
}
