/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run fulcrumgenomics/twistcgp -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '10.m',
    ]
    // Heavy/annotation processes fail or are too slow on the empty GATK4_MUTECT2 output
    // of the plain smoke test. The nf-test suite re-enables the ones it needs (with real
    // fixtures) via conf/test_annotation.config.
    withName: SNPEFF_SNPEFF {
        ext.when = { false }
    }
    withName: '.*:SNPEFF_DOWNLOAD' {
        ext.when = { false }
    }
    withName: TABIX_BGZIPTABIX {
        ext.when = { false }
    }
    withName: '.*:ENSEMBLVEP_DOWNLOAD' {
        ext.when = { false }
    }
    withName: '.*:ENSEMBLVEP_VEP' {
        ext.when = { false }
    }
    withName: "GATK4_FILTERMUTECTCALLS" {
        ext.when = { false }
    }
    withName: "TMB_PYTMB" {
        ext.when = { false }
    }
    withName: "MSISENSOR2_MSI" {
        ext.when = { false }
    }
    withName: "MSISENSORPRO_PRO" {
        ext.when = { false }
    }
    withName: "CIVICPY_UPDATE_CACHE" {
        ext.when = { false }
    }
}

params {
    skip_tmb     = true
    skip_msi     = true
    skip_civicpy = true
    config_profile_name = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // nf-core modules test-data base path
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

    // Input: samplesheet is local; FASTQs inside it reference nf-core URLs directly
    input = "${projectDir}/assets/test-data/samplesheet.csv"

    // chr21 reference files from nf-core modules test data
    fasta     = params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta'
    fasta_fai = params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai'
    dict      = params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.dict'

    // baits: chr21 interval_list (Picard format; converted to BED by BAITS_TO_BED where needed)
    baits   = params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.interval_list'
    // targets: committed BED of the same chr21 region. The pipeline feeds targets straight to
    // bcftools --targets-file and pyTMB --bed, which reject a Picard interval_list, so targets must be BED.
    targets = "${projectDir}/assets/test-data/targets.bed"

    // VEP cache (tarball; UNTAR_VEP_CACHE extracts it before VEP runs)
    ensemblvep_cache         = params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/vep_cache_113.tar.gz'
    ensemblvep_cache_version = '113'

    // SnpEff cache (pre-extracted directory on S3)
    snpeff_db    = '105'
    snpeff_cache = 's3://annotation-cache/snpeff_cache/GRCh38.105'

}
