/*
    Config for the VCF_ANNOTATE subworkflow test.

    Supplies just the two module args the subworkflow needs, mirroring
    conf/modules.config, without pulling in that file's params-dependent
    publishDir blocks:
      - SNPEFF_SNPEFF : register the cached GRCh38.105 genome (snpEff 5.3a does
        not auto-register a -dataDir genome; test-only, see conf/test_annotation.config)
      - ENSEMBLVEP_VEP: the pipeline's VEP args (minus --af_gnomadg, which the trimmed
        test cache does not carry), so the emitted CSQ closely mirrors production
*/

process {
    // conf/test.config (via -profile test) disables these for the empty smoke test;
    // this subworkflow test runs them against the committed hotspot fixtures.
    withName: 'SNPEFF_SNPEFF' {
        ext.when = { true }
        ext.args = '-canon -v -configOption GRCh38.105.genome=GRCh38.105'
    }
    withName: 'TABIX_BGZIPTABIX' {
        ext.when = { true }
    }
    withName: '.*:ENSEMBLVEP_VEP' {
        ext.when = { true }
        ext.args = '--format vcf --vcf --af_gnomade --af_1kg'
    }
}
